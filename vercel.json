{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "jekyll",
  "buildCommand": "bundle exec jekyll build",
  "outputDirectory": "_site",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
